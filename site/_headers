# Plaatjes, geluid en video een uur bewaren in de browser, zodat terugvegen meteen werkt.
/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/media/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/audio/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
